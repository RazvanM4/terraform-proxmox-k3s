[k3s_server]
%{ for name, node in servers ~}
${name} ansible_host=${node.ipv4}
%{ endfor ~}

[k3s_agent]
%{ for name, node in agents ~}
${name} ansible_host=${node.ipv4}
%{ endfor ~}

[k3s_cluster:children]
k3s_server
k3s_agent

[k3s_cluster:vars]
ansible_user=${ansible_user}
ansible_python_interpreter=/usr/bin/python3
